# Copy to .env.local and fill in. Required for the contact / demo forms.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Official BuildAlly email. All sender display names and mailto links are
# derived from these in src/lib/email.js — never hardcode an address elsewhere.
#
# Sender shown on outgoing email. Must be on a domain verified in Resend.
EMAIL_FROM="BuildAlly <support@buildally.in>"

# Inbox that receives contact / demo form submissions.
EMAIL_TO=support@buildally.in

# Address displayed on the site (footer, contact page, legal pages).
# NEXT_PUBLIC_ so it is available in the browser bundle; inlined at build time.
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildally.in
